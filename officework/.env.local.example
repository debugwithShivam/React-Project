# Private local overrides. Copy to .env.local and fill in a local Maps browser key if desired.
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_KEY=REPLACE_WITH_A_RANDOM_LOCAL_KEY_AT_LEAST_32_CHARACTERS

DB_CONNECTION=sqlite
DB_DATABASE=database/local-dev.sqlite

ADMIN_EMAIL=admin@aimedixmeds.local
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_ONLY_PASSWORD

# Optional; the local setup script stores this in the local settings database.
MEDICAL_GOOGLE_MAPS_BROWSER_API_KEY=
